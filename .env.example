# Local Compose template only. Replace every placeholder before starting the stack.
# Do not reuse these values in a shared or production environment.
MYSQL_ROOT_PASSWORD=replace_with_local_mysql_root_password
IDENTITY_DB_PASSWORD=replace_with_unique_identity_db_password
AGENT_DB_PASSWORD=replace_with_unique_agent_db_password
POLICY_DB_PASSWORD=replace_with_unique_policy_db_password
AI_ANALYSIS_DB_PASSWORD=replace_with_unique_ai_analysis_db_password
RUNTIME_DB_PASSWORD=replace_with_unique_runtime_db_password
AUDIT_DB_PASSWORD=replace_with_unique_audit_db_password
NOTIFICATION_DB_PASSWORD=replace_with_unique_notification_db_password

RABBITMQ_USERNAME=replace_with_local_rabbitmq_username
RABBITMQ_PASSWORD=replace_with_local_rabbitmq_password

# Generate a local-only RSA key pair as described in docs/infrastructure.md.
# The private-key value must be an unencrypted PKCS#8 DER key encoded as Base64;
# the public-key value must be an X.509 SubjectPublicKeyInfo DER key in Base64.
AUTH_SIGNING_PRIVATE_KEY_BASE64=replace_with_base64_pkcs8_rsa_private_key
AUTH_SIGNING_PUBLIC_KEY_BASE64=replace_with_base64_x509_rsa_public_key
AUTH_SIGNING_KEY_ID=agentshield-local-rsa-1

# Distinct confidential OAuth client secrets. Use high-entropy random values.
RUNTIME_GATEWAY_CLIENT_SECRET=replace_with_unique_runtime_policy_client_secret
RUNTIME_GATEWAY_ANALYSIS_CLIENT_SECRET=replace_with_unique_runtime_analysis_client_secret

# Passwords protect generated development-only TLS keystore/truststore files.
DEV_TLS_KEYSTORE_PASSWORD=replace_with_local_tls_keystore_password
DEV_TLS_TRUSTSTORE_PASSWORD=replace_with_local_tls_truststore_password

# Public browser URLs for local Compose. These are not secrets.
MYSQL_HOST_PORT=3306
PUBLIC_FRONTEND_URL=http://localhost:3000
PUBLIC_GATEWAY_URL=http://localhost:8080
PUBLIC_AUTH_REDIRECT_URI=http://localhost:3000/auth/callback
PUBLIC_FRONTEND_API_BASE_URL=
AUTH_SPA_CLIENT_ID=agentshield-react-spa
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_CORS_ALLOWED_ORIGINS=http://localhost:3000
AGENT_CORS_ALLOWED_ORIGINS=http://localhost:3000
POLICY_CORS_ALLOWED_ORIGINS=http://localhost:3000
AI_ANALYSIS_CORS_ALLOWED_ORIGINS=http://localhost:3000
AUDIT_CORS_ALLOWED_ORIGINS=http://localhost:3000
NOTIFICATION_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional LLM integration. Leave disabled for a no-cost local stack.
AI_LLM_ENABLED=false
AI_LLM_PROVIDER=none
OPENAI_API_KEY=
