# Copy outside the repository (for example /etc/agentshield/production.env), chmod 600,
# replace every placeholder, and inject secrets from a protected secret manager.
PUBLIC_DOMAIN=replace_with_dns_name_pointing_to_this_vm
CADDY_EMAIL=replace_with_tls_contact_email
CADDY_IMAGE=replace_with_pinned_caddy_version_and_digest
MYSQL_IMAGE=replace_with_pinned_mysql_8_4_arm64_digest
RABBITMQ_IMAGE=replace_with_pinned_rabbitmq_4_1_arm64_digest
TLS_INIT_IMAGE=replace_with_pinned_temurin_21_jre_arm64_digest
RABBITMQ_PROVISION_IMAGE=replace_with_pinned_python_alpine_arm64_digest
RELEASE_TAG=replace_with_immutable_release_tag
IMAGE_NAMESPACE=replace_with_registry_namespace
BACKUP_AGE_RECIPIENT=replace_with_age1_public_recipient_from_backup_key
AUTH_SPA_CLIENT_ID=agentshield-react-spa

# OCI/local MySQL. The first value exists only because the base Compose file is merged;
# the overlay replaces app RabbitMQ credentials before containers start.
MYSQL_ROOT_PASSWORD=replace_with_random_secret
IDENTITY_DB_PASSWORD=replace_with_unique_random_secret
AGENT_DB_PASSWORD=replace_with_unique_random_secret
POLICY_DB_PASSWORD=replace_with_unique_random_secret
AI_ANALYSIS_DB_PASSWORD=replace_with_unique_random_secret
RUNTIME_DB_PASSWORD=replace_with_unique_random_secret
AUDIT_DB_PASSWORD=replace_with_unique_random_secret
NOTIFICATION_DB_PASSWORD=replace_with_unique_random_secret

# Unique administrator + service-specific RabbitMQ accounts. Keep admin credentials
# limited to provisioning and operations; application containers get only their own account.
RABBITMQ_USERNAME=replace_with_random_unused_local_profile_user
RABBITMQ_PASSWORD=replace_with_unique_random_secret
RABBITMQ_ADMIN_USERNAME=replace_with_unique_random_user
RABBITMQ_ADMIN_PASSWORD=replace_with_unique_random_secret
RABBITMQ_IDENTITY_USERNAME=replace_with_unique_random_user
RABBITMQ_IDENTITY_PASSWORD=replace_with_unique_random_secret
RABBITMQ_AGENT_USERNAME=replace_with_unique_random_user
RABBITMQ_AGENT_PASSWORD=replace_with_unique_random_secret
RABBITMQ_POLICY_USERNAME=replace_with_unique_random_user
RABBITMQ_POLICY_PASSWORD=replace_with_unique_random_secret
RABBITMQ_AI_ANALYSIS_USERNAME=replace_with_unique_random_user
RABBITMQ_AI_ANALYSIS_PASSWORD=replace_with_unique_random_secret
RABBITMQ_RUNTIME_USERNAME=replace_with_unique_random_user
RABBITMQ_RUNTIME_PASSWORD=replace_with_unique_random_secret
RABBITMQ_AUDIT_USERNAME=replace_with_unique_random_user
RABBITMQ_AUDIT_PASSWORD=replace_with_unique_random_secret
RABBITMQ_NOTIFICATION_USERNAME=replace_with_unique_random_user
RABBITMQ_NOTIFICATION_PASSWORD=replace_with_unique_random_secret
RABBITMQ_GATEWAY_USERNAME=replace_with_unique_random_user
RABBITMQ_GATEWAY_PASSWORD=replace_with_unique_random_secret

# Identity signing and confidential gateway clients. Inject the private key value only into
# Identity at deploy time. Keep the key-manager as authoritative storage; never commit this file.
AUTH_SIGNING_PRIVATE_KEY_BASE64=replace_with_secret_manager_injected_pkcs8_der_base64
AUTH_SIGNING_PUBLIC_KEY_BASE64=replace_with_x509_der_public_key_base64
AUTH_SIGNING_KEY_ID=replace_with_unique_key_id
RUNTIME_GATEWAY_CLIENT_SECRET=replace_with_secret_manager_injected_random_secret
RUNTIME_GATEWAY_ANALYSIS_CLIENT_SECRET=replace_with_secret_manager_injected_random_secret

# Development-only internal HTTPS keystore generation. Public HTTPS is issued by Caddy.
DEV_TLS_KEYSTORE_PASSWORD=replace_with_unique_random_secret
DEV_TLS_TRUSTSTORE_PASSWORD=replace_with_unique_random_secret

# Runtime destinations must be explicit, reviewed HTTPS endpoints; never use mock.echo.
RUNTIME_TOOL_DESTINATIONS=replace_with_registered_tool_id_equals_https_url
AI_LLM_ENABLED=false
AI_LLM_PROVIDER=none
OPENAI_API_KEY=

# Required interpolation by the base local Compose file. The overlay sets the real HTTPS values.
MYSQL_HOST_PORT=3306
PUBLIC_FRONTEND_URL=http://localhost:3000
PUBLIC_GATEWAY_URL=http://localhost:8080
PUBLIC_AUTH_REDIRECT_URI=http://localhost:3000/auth/callback
PUBLIC_FRONTEND_API_BASE_URL=
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_CORS_ALLOWED_ORIGINS=http://localhost:3000
AGENT_CORS_ALLOWED_ORIGINS=http://localhost:3000
POLICY_CORS_ALLOWED_ORIGINS=http://localhost:3000
AI_ANALYSIS_CORS_ALLOWED_ORIGINS=http://localhost:3000
AUDIT_CORS_ALLOWED_ORIGINS=http://localhost:3000
NOTIFICATION_CORS_ALLOWED_ORIGINS=http://localhost:3000
