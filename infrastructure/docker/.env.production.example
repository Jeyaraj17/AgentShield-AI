# Production Compose template. Copy outside the repository and inject all secrets from a secret manager.
# Replace every placeholder. Never commit the populated file.
PUBLIC_DOMAIN=replace_with_public_fqdn
CADDY_EMAIL=replace_with_tls_operations_email
CADDY_IMAGE=replace_with_pinned_caddy_image

# Pin all application images to immutable release tags or digests.
IDENTITY_SERVICE_IMAGE=replace_with_identity_image_digest
AGENT_MANAGEMENT_IMAGE=replace_with_agent_management_image_digest
POLICY_ENGINE_IMAGE=replace_with_policy_engine_image_digest
AI_ANALYSIS_IMAGE=replace_with_ai_analysis_image_digest
RUNTIME_SECURITY_GATEWAY_IMAGE=replace_with_runtime_gateway_image_digest
AUDIT_SERVICE_IMAGE=replace_with_audit_image_digest
NOTIFICATION_SERVICE_IMAGE=replace_with_notification_image_digest
API_GATEWAY_IMAGE=replace_with_api_gateway_image_digest
FRONTEND_IMAGE=replace_with_frontend_image_digest

# Signing material must come from a production key manager. Keep the active private key out of source control.
AUTH_SIGNING_PRIVATE_KEY_BASE64=replace_with_secret_manager_reference_or_injected_value
AUTH_SIGNING_PUBLIC_KEY_BASE64=replace_with_public_key_der_base64
AUTH_SIGNING_KEY_ID=replace_with_unique_active_key_id
AUTH_SIGNING_PREVIOUS_PUBLIC_KEYS=
RUNTIME_GATEWAY_CLIENT_SECRET=replace_with_secret_manager_injected_value
RUNTIME_GATEWAY_ANALYSIS_CLIENT_SECRET=replace_with_secret_manager_injected_value

# Private managed MySQL endpoints. Each URL must use TLS with certificate/hostname verification.
IDENTITY_DB_URL=jdbc:mysql://replace_with_private_mysql_host:3306/agentshield_identity?sslMode=VERIFY_IDENTITY
AGENT_DB_URL=jdbc:mysql://replace_with_private_mysql_host:3306/agent_management?sslMode=VERIFY_IDENTITY
POLICY_DB_URL=jdbc:mysql://replace_with_private_mysql_host:3306/policy_engine?sslMode=VERIFY_IDENTITY
AI_ANALYSIS_DB_URL=jdbc:mysql://replace_with_private_mysql_host:3306/ai_analysis?sslMode=VERIFY_IDENTITY
RUNTIME_DB_URL=jdbc:mysql://replace_with_private_mysql_host:3306/runtime_security_gateway?sslMode=VERIFY_IDENTITY
AUDIT_DB_URL=jdbc:mysql://replace_with_private_mysql_host:3306/audit_service?sslMode=VERIFY_IDENTITY
NOTIFICATION_DB_URL=jdbc:mysql://replace_with_private_mysql_host:3306/notification_service?sslMode=VERIFY_IDENTITY
IDENTITY_DB_USERNAME=replace_with_identity_db_user
AGENT_DB_USERNAME=replace_with_agent_db_user
POLICY_DB_USERNAME=replace_with_policy_db_user
AI_ANALYSIS_DB_USERNAME=replace_with_ai_analysis_db_user
RUNTIME_DB_USERNAME=replace_with_runtime_db_user
AUDIT_DB_USERNAME=replace_with_audit_db_user
NOTIFICATION_DB_USERNAME=replace_with_notification_db_user
IDENTITY_DB_PASSWORD=replace_with_secret_manager_injected_value
AGENT_DB_PASSWORD=replace_with_secret_manager_injected_value
POLICY_DB_PASSWORD=replace_with_secret_manager_injected_value
AI_ANALYSIS_DB_PASSWORD=replace_with_secret_manager_injected_value
RUNTIME_DB_PASSWORD=replace_with_secret_manager_injected_value
AUDIT_DB_PASSWORD=replace_with_secret_manager_injected_value
NOTIFICATION_DB_PASSWORD=replace_with_secret_manager_injected_value

# Private TLS broker endpoint and separate publisher/consumer accounts with least-privilege vhost permissions.
RABBITMQ_ADDRESSES=replace_with_private_broker_host:5671
RABBITMQ_VIRTUAL_HOST=/agentshield
IDENTITY_RABBITMQ_USERNAME=replace_with_identity_broker_user
IDENTITY_RABBITMQ_PASSWORD=replace_with_secret_manager_injected_value
AGENT_RABBITMQ_USERNAME=replace_with_agent_broker_user
AGENT_RABBITMQ_PASSWORD=replace_with_secret_manager_injected_value
POLICY_RABBITMQ_USERNAME=replace_with_policy_broker_user
POLICY_RABBITMQ_PASSWORD=replace_with_secret_manager_injected_value
AI_ANALYSIS_RABBITMQ_USERNAME=replace_with_analysis_broker_user
AI_ANALYSIS_RABBITMQ_PASSWORD=replace_with_secret_manager_injected_value
RUNTIME_RABBITMQ_USERNAME=replace_with_runtime_broker_user
RUNTIME_RABBITMQ_PASSWORD=replace_with_secret_manager_injected_value
AUDIT_RABBITMQ_USERNAME=replace_with_audit_broker_user
AUDIT_RABBITMQ_PASSWORD=replace_with_secret_manager_injected_value
NOTIFICATION_RABBITMQ_USERNAME=replace_with_notification_broker_user
NOTIFICATION_RABBITMQ_PASSWORD=replace_with_secret_manager_injected_value

# Trusted internal CA/truststore and per-service TLS keystores are mounted read-only as Compose secrets/files.
INTERNAL_TRUSTSTORE_FILE=/secure/path/agentshield-truststore.p12
INTERNAL_TRUSTSTORE_PASSWORD=replace_with_secret_manager_injected_value
INTERNAL_CA_FILE=/secure/path/agentshield-internal-ca.pem
IDENTITY_TLS_KEYSTORE_FILE=/secure/path/identity.p12
AGENT_MANAGEMENT_TLS_KEYSTORE_FILE=/secure/path/agent-management.p12
POLICY_ENGINE_TLS_KEYSTORE_FILE=/secure/path/policy-engine.p12
AI_ANALYSIS_TLS_KEYSTORE_FILE=/secure/path/ai-analysis.p12
RUNTIME_GATEWAY_TLS_KEYSTORE_FILE=/secure/path/runtime-gateway.p12
AUDIT_SERVICE_TLS_KEYSTORE_FILE=/secure/path/audit-service.p12
NOTIFICATION_SERVICE_TLS_KEYSTORE_FILE=/secure/path/notification-service.p12
IDENTITY_TLS_KEYSTORE_PASSWORD=replace_with_secret_manager_injected_value
AGENT_MANAGEMENT_TLS_KEYSTORE_PASSWORD=replace_with_secret_manager_injected_value
POLICY_ENGINE_TLS_KEYSTORE_PASSWORD=replace_with_secret_manager_injected_value
AI_ANALYSIS_TLS_KEYSTORE_PASSWORD=replace_with_secret_manager_injected_value
RUNTIME_GATEWAY_TLS_KEYSTORE_PASSWORD=replace_with_secret_manager_injected_value
AUDIT_SERVICE_TLS_KEYSTORE_PASSWORD=replace_with_secret_manager_injected_value
NOTIFICATION_SERVICE_TLS_KEYSTORE_PASSWORD=replace_with_secret_manager_injected_value

# Never use the local mock tool in a deployment. All destinations must be pre-registered and reviewed.
RUNTIME_TOOL_DESTINATIONS=replace_with_approved_action_https_destinations
AI_LLM_ENABLED=false
AI_LLM_PROVIDER=none
OPENAI_API_KEY=

# Compose evaluates local-profile variables before applying the production overlay. These services remain disabled.
# Set strong, unique values even though these local-only services are not started.
MYSQL_ROOT_PASSWORD=replace_with_random_unused_local_profile_value
RABBITMQ_USERNAME=replace_with_random_unused_local_profile_user
RABBITMQ_PASSWORD=replace_with_random_unused_local_profile_value
DEV_TLS_KEYSTORE_PASSWORD=replace_with_random_unused_local_profile_value
DEV_TLS_TRUSTSTORE_PASSWORD=replace_with_random_unused_local_profile_value
